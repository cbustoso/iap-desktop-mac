<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>App</string>
    <key>CFBundleIdentifier</key>
    <string>com.iapdesktop.mac</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>IAP Desktop Mac</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!--
      OAuth client ID por defecto (CBU-36). Maintainer: sustituir el
      placeholder por un client ID de tipo "Desktop app" creado en
      https://console.cloud.google.com/apis/credentials
      (formato: 123456789-abc.apps.googleusercontent.com).
      Con el placeholder, la app usa el override guardado por el usuario o
      la variable de entorno GOOGLE_OAUTH_CLIENT_ID. Un client ID de app
      instalada no es secreto (Google lo documenta así).
    -->
    <key>OAuthClientID</key>
    <string>__OAUTH_CLIENT_ID__</string>
</dict>
</plist>
